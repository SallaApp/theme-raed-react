{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // The knip plugin for TanStack Router assumes src/routes; this theme uses app/routes.
  "entry": [
    "app/client.tsx",
    "app/server.ts",
    "app/start.ts",
    "app/router.tsx",
    "app/routes.ts",
    "app/routes/**/*.{ts,tsx}",
    // Target of the vite alias that stubs CSS imports; never imported by path.
    "app/lib/empty-css.ts",
  ],
  "ignore": [
    // Tailwind configs loaded by name from Sass (@config in critical*.scss); knip does not follow Sass.
    "app/styles/critical.tailwind.cjs",
    "app/styles/critical-product.tailwind.cjs",
    // Pulled in by Sass (@import in app.scss and critical.scss) and by the swiper/css vite alias; knip does not follow Sass.
    "app/styles/vendor/swiper.css",
  ],
  // Generated by the TanStack router plugin; gitignored and absent on a clean checkout.
  "ignoreUnresolved": ["^\\./routeTree\\.gen$"],
}
