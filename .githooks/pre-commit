#!/bin/sh
# Format and lint staged files only. Skip in an emergency: git commit --no-verify
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

staged=$(mktemp) || exit 1
trap 'rm -f "$staged" "$staged.lint"' EXIT

git diff --cached --name-only --diff-filter=ACMR -z -- \
  '*.ts' '*.tsx' '*.js' '*.json' '*.scss' '*.css' '*.md' >"$staged" || exit 1
[ -s "$staged" ] || exit 0

# Re-staging a partially staged file would commit its unstaged changes too.
partial=0
while IFS= read -r file; do
  if ! git diff --quiet -- "$file"; then
    echo "pre-commit: $file has unstaged changes; stage or stash them first." >&2
    partial=1
  fi
done <<EOF
$(tr '\0' '\n' <"$staged")
EOF
[ "$partial" -eq 0 ] || exit 1

xargs -0 pnpm exec prettier --write --ignore-unknown --no-error-on-unmatched-pattern <"$staged" || exit 1

tr '\0' '\n' <"$staged" | grep -E '\.(ts|tsx|js)$' | tr '\n' '\0' >"$staged.lint"
if [ -s "$staged.lint" ]; then
  xargs -0 pnpm exec eslint --fix --no-warn-ignored <"$staged.lint" || exit 1
fi

xargs -0 git add -- <"$staged"
