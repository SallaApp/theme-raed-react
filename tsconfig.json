{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "files": [
    "node_modules/@salla.sa/twilight-theme-engine/dist/ambient/salla-components.d.ts",
    "node_modules/@salla.sa/twilight-theme-engine/dist/ambient/virtual-modules.d.ts"
  ],
  "include": ["app/**/*", "vite.config.ts", "*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
